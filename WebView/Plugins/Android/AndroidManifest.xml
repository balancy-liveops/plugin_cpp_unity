<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.balancy.webview">

    <!-- Internet permission for WebView -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Optional: Allow file access for local content -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    
    <!-- Hardware acceleration for better WebView performance -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    
    <application>
        <!-- This manifest will be merged with the main Unity app manifest -->
        <!-- No activity declarations needed as we're using overlay WebView -->
    </application>
</manifest>
